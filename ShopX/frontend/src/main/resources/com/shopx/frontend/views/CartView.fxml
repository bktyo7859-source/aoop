<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="720.0" prefWidth="1080.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.shopx.frontend.controller.CartController">
    <!-- Top Bar -->
    <top>
        <VBox spacing="0.0">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="top-bar">
                    <children>
                        <Button mnemonicParsing="false" onAction="#continueShopping" styleClass="brand-logo-btn">
                            <graphic>
                                <HBox alignment="CENTER" spacing="2.0">
                                    <children>
                                        <Label styleClass="brand-title" text="Shop" />
                                        <Label styleClass="brand-accent" text="X" />
                                    </children>
                                </HBox>
                            </graphic>
                        </Button>
                        <Button mnemonicParsing="false" onAction="#continueShopping" styleClass="btn-secondary" text="← Continue Shopping" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label styleClass="view-title" text="Shopping Cart" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button mnemonicParsing="false" onAction="#loadCartItems" styleClass="btn-secondary" text="↻ Refresh" />
                    </children>
                </HBox>
                <Label fx:id="notificationLabel" maxWidth="1.7976931348623157E308" visible="false" />
            </children>
        </VBox>
    </top>

    <!-- Content Area -->
    <center>
        <HBox spacing="24.0">
            <padding>
                <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
            </padding>
            <children>
                <!-- Items Table / Empty View -->
                <StackPane HBox.hgrow="ALWAYS">
                    <children>
                        <TableView fx:id="cartTable" prefHeight="500.0">
                            <columns>
                                <TableColumn fx:id="productNameColumn" prefWidth="340.0" text="Product Name" />
                                <TableColumn fx:id="unitPriceColumn" prefWidth="120.0" text="Unit Price" />
                                <TableColumn fx:id="quantityColumn" prefWidth="100.0" text="Quantity" />
                                <TableColumn fx:id="subtotalColumn" prefWidth="120.0" text="Subtotal" />
                                <TableColumn fx:id="actionColumn" prefWidth="100.0" text="Action" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>

                        <!-- Empty Cart State -->
                        <VBox fx:id="emptyCartPane" alignment="CENTER" spacing="16.0" visible="false">
                            <children>
                                <Label style="-fx-font-size: 36px;" text="🛒" />
                                <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #475569;" text="Your Cart is Empty" />
                                <Label style="-fx-text-fill: #64748b;" text="Looks like you haven't added any items yet." />
                                <Button mnemonicParsing="false" onAction="#continueShopping" styleClass="btn-primary" text="Browse Products" />
                            </children>
                        </VBox>

                        <ProgressIndicator fx:id="loadingIndicator" maxHeight="40.0" maxWidth="40.0" visible="false" />
                    </children>
                </StackPane>

                <!-- Cart Summary Panel -->
                <VBox maxWidth="320.0" minWidth="280.0" spacing="16.0" styleClass="card">
                    <children>
                        <Label styleClass="section-title" text="Order Summary" />
                        
                        <VBox spacing="10.0" style="-fx-border-color: #e2e8f0; -fx-border-width: 1 0 1 0; -fx-padding: 12 0;">
                            <children>
                                <HBox alignment="CENTER_LEFT">
                                    <children>
                                        <Label style="-fx-text-fill: #64748b;" text="Total Items:" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Label fx:id="itemCountLabel" style="-fx-font-weight: bold;" text="0 items" />
                                    </children>
                                </HBox>
                                <HBox alignment="CENTER_LEFT">
                                    <children>
                                        <Label style="-fx-text-fill: #64748b;" text="Estimated Shipping:" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Label style="-fx-font-weight: bold; -fx-text-fill: #10b981;" text="FREE" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <HBox alignment="CENTER_LEFT">
                            <children>
                                <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" text="Total Amount:" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label fx:id="totalAmountLabel" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2563eb;" text="₹0.00" />
                            </children>
                        </HBox>

                        <!-- Action Buttons -->
                        <Button fx:id="checkoutButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#proceedToCheckout" styleClass="btn-primary" text="Proceed to Checkout →" />
                        <Button fx:id="clearCartButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleClearCart" styleClass="btn-secondary" text="Clear Cart" />
                    </children>
                </VBox>
            </children>
        </HBox>
    </center>
</BorderPane>
