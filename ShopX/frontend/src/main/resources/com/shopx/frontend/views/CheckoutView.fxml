<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="720.0" prefWidth="1080.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.shopx.frontend.controller.CheckoutController">
    <!-- Top Bar -->
    <top>
        <VBox spacing="0.0">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="top-bar">
                    <children>
                        <Button mnemonicParsing="false" onAction="#backToCart" styleClass="brand-logo-btn">
                            <graphic>
                                <HBox alignment="CENTER" spacing="2.0">
                                    <children>
                                        <Label styleClass="brand-title" text="Shop" />
                                        <Label styleClass="brand-accent" text="X" />
                                    </children>
                                </HBox>
                            </graphic>
                        </Button>
                        <Button fx:id="backToCartButton" mnemonicParsing="false" onAction="#backToCart" styleClass="btn-secondary" text="← Back to Cart" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label styleClass="view-title" text="Order Checkout" />
                        <Region HBox.hgrow="ALWAYS" />
                    </children>
                </HBox>
                <Label fx:id="errorLabel" maxWidth="1.7976931348623157E308" styleClass="notification-error" visible="false" wrapText="true" />
            </children>
        </VBox>
    </top>

    <!-- Main Content -->
    <center>
        <HBox spacing="24.0">
            <padding>
                <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
            </padding>
            <children>
                <!-- Left: Customer Info and Items Review -->
                <VBox spacing="16.0" HBox.hgrow="ALWAYS">
                    <children>
                        <!-- Customer Details Card -->
                        <VBox spacing="10.0" styleClass="card">
                            <children>
                                <Label styleClass="section-title" text="Customer Details" />
                                <HBox spacing="32.0">
                                    <children>
                                        <VBox spacing="4.0">
                                            <children>
                                                <Label style="-fx-font-size: 11px; -fx-text-fill: #64748b;" text="Name" />
                                                <Label fx:id="customerNameLabel" style="-fx-font-weight: bold; -fx-text-fill: #1e293b;" text="John Doe" />
                                            </children>
                                        </VBox>
                                        <VBox spacing="4.0">
                                            <children>
                                                <Label style="-fx-font-size: 11px; -fx-text-fill: #64748b;" text="Email" />
                                                <Label fx:id="customerEmailLabel" style="-fx-font-weight: bold; -fx-text-fill: #1e293b;" text="customer@shopx.local" />
                                            </children>
                                        </VBox>
                                        <VBox spacing="4.0">
                                            <children>
                                                <Label style="-fx-font-size: 11px; -fx-text-fill: #64748b;" text="Account Role" />
                                                <Label fx:id="customerRoleLabel" style="-fx-font-weight: bold; -fx-text-fill: #2563eb;" text="CUSTOMER" />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <!-- Items Table -->
                        <VBox spacing="8.0" VBox.vgrow="ALWAYS">
                            <children>
                                <Label styleClass="section-title" text="Review Order Items" />
                                <TableView fx:id="checkoutItemsTable" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="itemCol" prefWidth="320.0" text="Product Name" />
                                        <TableColumn fx:id="qtyCol" prefWidth="80.0" text="Qty" />
                                        <TableColumn fx:id="priceCol" prefWidth="120.0" text="Price" />
                                        <TableColumn fx:id="subtotalCol" prefWidth="120.0" text="Subtotal" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>
                            </children>
                        </VBox>
                    </children>
                </VBox>

                <!-- Right: Summary & Place Order -->
                <VBox maxWidth="320.0" minWidth="280.0" spacing="16.0" styleClass="card">
                    <children>
                        <Label styleClass="section-title" text="Payment &amp; Confirmation" />

                        <VBox spacing="10.0" style="-fx-border-color: #e2e8f0; -fx-border-width: 1 0 1 0; -fx-padding: 12 0;">
                            <children>
                                <HBox alignment="CENTER_LEFT">
                                    <children>
                                        <Label style="-fx-text-fill: #64748b;" text="Items Count:" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Label fx:id="summaryItemsCountLabel" style="-fx-font-weight: bold;" text="0 items" />
                                    </children>
                                </HBox>
                                <HBox alignment="CENTER_LEFT">
                                    <children>
                                        <Label style="-fx-text-fill: #64748b;" text="Payment Method:" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Label style="-fx-font-weight: bold; -fx-text-fill: #475569;" text="Simulated Checkout" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <HBox alignment="CENTER_LEFT">
                            <children>
                                <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" text="Grand Total:" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label fx:id="summaryTotalAmountLabel" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2563eb;" text="₹0.00" />
                            </children>
                        </HBox>

                        <VBox alignment="CENTER" spacing="10.0">
                            <children>
                                <Button fx:id="placeOrderButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handlePlaceOrder" styleClass="btn-success" text="Place Order Now" />
                                <ProgressIndicator fx:id="progressIndicator" maxHeight="28.0" maxWidth="28.0" visible="false" />
                            </children>
                        </VBox>

                        <!-- Academic prototype notice -->
                        <VBox spacing="4.0" style="-fx-background-color: #f8fafc; -fx-padding: 10px; -fx-background-radius: 6px;">
                            <children>
                                <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #475569;" text="ℹ Prototype Notice" />
                                <Label style="-fx-font-size: 10px; -fx-text-fill: #64748b;" text="Placing the order executes inventory deduction and creates a confirmed order in PostgreSQL." wrapText="true" />
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </children>
        </HBox>
    </center>
</BorderPane>
