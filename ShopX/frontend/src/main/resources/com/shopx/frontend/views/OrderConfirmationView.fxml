<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="720.0" prefWidth="1080.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.shopx.frontend.controller.OrderConfirmationController">
    <!-- Top Bar -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="top-bar">
            <children>
                <Button mnemonicParsing="false" onAction="#continueShopping" styleClass="brand-logo-btn">
                    <graphic>
                        <HBox alignment="CENTER" spacing="2.0">
                            <children>
                                <Label styleClass="brand-title" text="Shop" />
                                <Label styleClass="brand-accent" text="X" />
                            </children>
                        </HBox>
                    </graphic>
                </Button>
                <Region HBox.hgrow="ALWAYS" />
                <Button mnemonicParsing="false" onAction="#continueShopping" styleClass="btn-primary" text="← Continue Shopping" />
            </children>
        </HBox>
    </top>

    <!-- Content -->
    <center>
        <VBox alignment="TOP_CENTER" spacing="20.0">
            <padding>
                <Insets bottom="32.0" left="48.0" right="48.0" top="24.0" />
            </padding>
            <children>
                <!-- Success Banner -->
                <VBox alignment="CENTER" spacing="8.0">
                    <children>
                        <Label style="-fx-font-size: 40px; -fx-text-fill: #10b981;" text="✓" />
                        <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #0f172a;" text="Order Confirmed!" />
                        <Label style="-fx-text-fill: #64748b;" text="Your order has been recorded in the database and inventory has been adjusted." />
                    </children>
                </VBox>

                <!-- Order Meta Card -->
                <HBox alignment="CENTER" spacing="32.0" styleClass="card" maxWidth="800.0">
                    <padding>
                        <Insets bottom="16.0" left="24.0" right="24.0" top="16.0" />
                    </padding>
                    <children>
                        <VBox alignment="CENTER" spacing="4.0">
                            <children>
                                <Label style="-fx-font-size: 11px; -fx-text-fill: #64748b;" text="ORDER NUMBER" />
                                <Label fx:id="orderIdLabel" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" text="Order #..." />
                            </children>
                        </VBox>

                        <VBox alignment="CENTER" spacing="4.0">
                            <children>
                                <Label style="-fx-font-size: 11px; -fx-text-fill: #64748b;" text="CUSTOMER" />
                                <Label fx:id="customerNameLabel" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" text="Customer" />
                            </children>
                        </VBox>

                        <VBox alignment="CENTER" spacing="4.0">
                            <children>
                                <Label style="-fx-font-size: 11px; -fx-text-fill: #64748b;" text="STATUS" />
                                <Label fx:id="orderStatusLabel" styleClass="status-badge-confirmed" text="CONFIRMED" />
                            </children>
                        </VBox>

                        <VBox alignment="CENTER" spacing="4.0">
                            <children>
                                <Label style="-fx-font-size: 11px; -fx-text-fill: #64748b;" text="TOTAL AMOUNT" />
                                <Label fx:id="totalAmountLabel" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2563eb;" text="₹0.00" />
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <!-- Items Details Table -->
                <VBox spacing="8.0" maxWidth="800.0" VBox.vgrow="ALWAYS">
                    <children>
                        <Label styleClass="section-title" text="Purchased Items" />
                        <TableView fx:id="orderItemsTable" prefHeight="240.0">
                            <columns>
                                <TableColumn fx:id="itemCol" prefWidth="380.0" text="Product Name" />
                                <TableColumn fx:id="qtyCol" prefWidth="100.0" text="Quantity" />
                                <TableColumn fx:id="priceCol" prefWidth="140.0" text="Unit Price" />
                                <TableColumn fx:id="subtotalCol" prefWidth="140.0" text="Subtotal" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                    </children>
                </VBox>

                <!-- Action Button -->
                <Button fx:id="continueShoppingButton" mnemonicParsing="false" onAction="#continueShopping" styleClass="btn-primary" text="Continue Shopping" />
            </children>
        </VBox>
    </center>
</BorderPane>
