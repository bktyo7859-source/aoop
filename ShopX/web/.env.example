# =============================================================================
# ShopCX Frontend Production Environment Variables
# =============================================================================

# (Optional) Remote Spring Boot Backend API Base URL
# If your backend is deployed to Render, Railway, AWS, or Fly.io:
# Example: VITE_API_BASE_URL=https://shopx-backend.onrender.com/api
#
# If left blank, ShopCX automatically uses relative '/api' or its built-in
# luxury resilient fallback data engine so the site is 100% functional on Vercel.
VITE_API_BASE_URL=
